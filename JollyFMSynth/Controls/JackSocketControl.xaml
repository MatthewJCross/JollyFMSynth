<UserControl x:Class="JollyFMSynth.Controls.JackSocketControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JollyFMSynth.Controls"
             mc:Ignorable="d" 
             Width="36" Height="40">
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Outer ring -->
        <Ellipse Width="20" Height="20" >
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.3,0.3">
                    <GradientStop Color="#555" Offset="0"/>
                    <GradientStop Color="#222" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Glowing ring -->
        <Ellipse Width="20" Height="20" Stroke="#44FFFF" StrokeThickness="4" Visibility="Hidden" x:Name="GlowRing"/>

        <!-- Inner socket -->
        <Ellipse x:Name="InnerSocket" Width="10" Height="10" Fill="Black" Stroke="DarkGray" StrokeThickness="1" />

        <TextBlock Text="{Binding SocketLabel, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Grid.Row="1" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FFC0C0C0"/>

        <!-- Visual States -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PlugState">
                <VisualState x:Name="UnpluggedVis"/>
                <VisualState x:Name="PluggedInVis">
                    <Storyboard>
                        <ColorAnimation Storyboard.TargetName="InnerSocket" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#00FF00" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Hover triggers -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GlowRing" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Hidden}" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</UserControl>
    