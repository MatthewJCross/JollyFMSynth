<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\JollySynth.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="3.3.0" /></ItemGroup>
  <ItemGroup><Content Include="Presets\*.jollypatch" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <None Remove="Resources\JollySynth.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\JollySynth.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\JollySynth.png" />
  </ItemGroup>
</Project>
