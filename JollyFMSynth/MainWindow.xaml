<Window x:Class="JollyFMSynth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JollyFMSynth.Controls"
        Title="Jolly FM Synth" Width="1200" Height="1100"
        MinWidth="800" MinHeight="490" Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" Closed="Window_Closed" WindowStyle="None" AllowsTransparency="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"/>
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Close"/>
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Maximize"/>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Minimize"/>
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Restore"/>
    </Window.CommandBindings>

    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Height="42" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Orientation="Horizontal">
                <Image Source="/Resources/JollySynth.png" Height="40" Margin="0,-4,0,0"/>
                <TextBlock Text="Jolly" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="8,-8,0,0" VerticalAlignment="Top" />
                <TextBlock Text="FM" FontSize="30" FontWeight="Bold" Foreground="Red" Margin="0,-8,0,0" VerticalAlignment="Top" />
                <TextBlock Text="Synth" FontSize="30" FontWeight="Bold" Foreground="BlueViolet" Margin="6,-8,0,0" VerticalAlignment="Top" />

            </StackPanel>

            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1" Margin="0,-16,0,0">
                <Button Style="{StaticResource MinimizeButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                <Button x:Name="RestoreButton" Visibility="Collapsed" Style="{StaticResource RestoreButtonStyle}" Command="{x:Static SystemCommands.RestoreWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Restore"/>
                <Button x:Name="MaximizeButton" Visibility="Visible" Style="{StaticResource MaximizeButtonStyle}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
            </StackPanel>
        </Grid>
        
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <controls:LfoPanel x:Name="LfoControls" DataContext="{Binding Lfo}"/>
            <controls:EffectsPanel x:Name="EffectsControls" DataContext="{Binding Effects}"/>
            <controls:MusicKeyboard x:Name="PianoKeyboard" Margin="0,0,0,5"/>
            <TextBlock Text="Keyboard: Z–M (C4–B4), Q–U (C5–B5) · ←/→ shift octaves · Drag knobs vertically · Shift: fine · Double-click: reset" Foreground="{StaticResource SecondaryTextBrush}"/>
            <WrapPanel>
                <TextBlock Text="Factory preset:" VerticalAlignment="Top" Margin="0,0,6,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="FactoryPresetPicker" ItemsSource="{Binding FactoryPresets}" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Top" SelectedItem="{Binding SelectedFactoryPreset, Mode=TwoWay}" ToolTip="Load a factory preset"/>
                <Button Content="Save Patch" Click="SavePatch_Click"/>
                <Button Content="Load Patch" Click="LoadPatch_Click"/>
                <Button Content="Play C4" Command="{Binding PlayCommand}"/>
                <Button Content="Stop" Command="{Binding StopCommand}"/>
                <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource AccentBrush}"/>
            </WrapPanel>
        </StackPanel>
        
        <Grid>
            <ScrollViewer x:Name="OperatorScroll" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ScrollChanged="OperatorScroll_ScrollChanged">
                <ItemsControl x:Name="OperatorItems" ItemsSource="{Binding Operators}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" Rows="2" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:OperatorControl Margin="6" VerticalAlignment="Top" Loaded="OperatorControl_Loaded"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Canvas x:Name="CableCanvas" ClipToBounds="True" Panel.ZIndex="2"/>
        </Grid>
    </DockPanel>
</Window>
