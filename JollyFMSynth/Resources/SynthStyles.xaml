<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared synthesizer palette -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101824"/>
    <SolidColorBrush x:Key="OperatorBackgroundBrush" Color="#1D2A3B"/>
    <SolidColorBrush x:Key="EnvelopeBackgroundBrush" Color="#172332"/>
    <SolidColorBrush x:Key="GraphBackgroundBrush" Color="#0F1824"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#24364D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#34475B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6DE0CB"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB8C8"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9DB1C4"/>
    <SolidColorBrush x:Key="KnobTextBrush" Color="#D9E4EE"/>
    <SolidColorBrush x:Key="ComboTextBrush" Color="#111827"/>

    <!-- Implicit styles shared by the main window and nested controls -->
    <Style TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource ComboTextBrush}"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Name="ToggleButton" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="Black" Width="8" Height="4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style x:Key="OperatorPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OperatorBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="6,6,6,2"/>
    </Style>
    
    <Style x:Key="EnvelopePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EnvelopeBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="LayoutRoot" Background="Transparent" Width="44" Height="30">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10" 
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.ClearTypeHint="Auto" TextOptions.TextRenderingMode="Aliased"  TextOptions.TextFormattingMode="Display"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LayoutRoot" Property="Background" Value="#E5E5E5"/>
                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Content" Value="&#xE949;"/>
    </Style>

    <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Content" Value="&#xE739;"/>
    </Style>

    <Style x:Key="RestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Content" Value="&#xE923;"/>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Content" Value="&#xE106;"/>
    </Style>
</ResourceDictionary>
